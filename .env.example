# =============================================================================
# Prottasha Housing Society (PHS-Finance) - Environment Configuration Template
# =============================================================================
# Copy this file to `.env` or `.env.local` for local development or platform env settings.
# All client-accessible Vite variables MUST be prefixed with `VITE_`.

# App Metadata & Deployment URL
VITE_APP_TITLE="PHS-Finance - Prottasha Housing Society"
VITE_APP_DESCRIPTION="Enterprise Financial Management, Director Share Ledger, Member Statements, and EC Governance System."
VITE_APP_URL="https://phs-finance-psi.vercel.app"

# Optional Gemini AI API Key (if server-side or client-side AI analysis is enabled)
GEMINI_API_KEY=""

# Application Host & Port Configuration (for local server or preview)
PORT=3000
HOST=0.0.0.0
